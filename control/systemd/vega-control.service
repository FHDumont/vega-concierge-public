# Vega Ops Console — maintenance panel (F-047, ADR-025). HOST service (native watchdog).
# Install in /etc/systemd/system/ (see control/systemd/install.sh) and enable on boot.
[Unit]
Description=Vega Ops Console (control panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the repo's owner, NOT root — the panel shells out to `docker compose` and up.sh, and
# writes control-audit.log into the repo; as root those artifacts lock the owner out.
# splunk is in the `docker` group, so compose works. install.sh substitutes VEGA_USER here.
User=splunk
Group=splunk
WorkingDirectory=/opt/vega-concierge/control
# The repo's .env carries CONTROL_PASSWORD and VEGA_REPO_DIR.
# Precedence (F-REAL-ENV-2): /etc/environment AFTER .env — injection by the replica (Ansible) wins over the file.
EnvironmentFile=-/opt/vega-concierge/.env
EnvironmentFile=-/etc/environment
Environment=VEGA_REPO_DIR=/opt/vega-concierge
ExecStart=/opt/vega-concierge/control/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9000
# Watchdog: never lets the panel go down (it's the infra's maintenance tool).
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
