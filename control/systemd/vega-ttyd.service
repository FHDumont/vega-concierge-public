# Vega Ops Console — web terminal (ttyd) "SSH via browser" (F-047, ADR-025). HOST service.
# Serves the host shell on localhost only; the panel proxies authenticated at /shell/ (no double Basic Auth).
# -b /shell = base-path aligned with the FastAPI proxy. Do NOT expose :7681 in the Security Group — only :9000.
[Unit]
Description=Vega Ops Console (web terminal via ttyd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vega-concierge
# Precedence (F-REAL-ENV-2): /etc/environment AFTER .env — injection by the replica (Ansible) wins over the file.
EnvironmentFile=-/opt/vega-concierge/.env
EnvironmentFile=-/etc/environment
ExecStart=/bin/sh -c 'exec ttyd -b /shell -i lo -p ${CONTROL_TTYD_PORT:-7681} -W bash'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
