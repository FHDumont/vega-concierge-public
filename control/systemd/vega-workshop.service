# Workshop guide (Hugo) — served on the VM at :1313 (F-DEPLOY-PROD-1).
# Requires hugo extended on the PATH (installed on the golden AMI).
[Unit]
Description=Vega workshop guide (Hugo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the repo's owner, NOT root — `hugo server` writes .hugo_build.lock/resources into the
# repo. install.sh substitutes VEGA_USER here.
User=splunk
Group=splunk
WorkingDirectory=/opt/vega-concierge/workshop
# Precedence (F-REAL-ENV-2): /etc/environment AFTER .env — injection by the replica (Ansible) wins over the file.
EnvironmentFile=-/opt/vega-concierge/.env
EnvironmentFile=-/etc/environment
ExecStart=/usr/bin/hugo server --bind 0.0.0.0 --port 1313 --baseURL http://127.0.0.1:1313/
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
