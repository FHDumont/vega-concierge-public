# Vega boot — Docker stack (fresh-state + pull + up) on the AMI/clone (F-DEPLOY-PROD-1).
# Control (vega-control/vega-ttyd) and workshop (vega-workshop) come up in parallel via multi-user.target.
[Unit]
Description=Vega Concierge stack boot (fresh-state + pull + up)
# Docker via package (docker.service) OR snap (snap.docker.dockerd.service) — a missing unit in After= is ignored.
After=docker.service snap.docker.dockerd.service network-online.target
Wants=network-online.target
# Ollama is soft — boot proceeds if the unit doesn't exist on the AMI.
After=ollama.service
Wants=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as the repo's owner, NOT root: root-created runtime artifacts (.env.runtime, audit log)
# would lock the owner out of running scripts/up.sh by hand. install.sh substitutes VEGA_USER here.
User=splunk
Group=splunk
WorkingDirectory=/opt/vega-concierge
# Precedence (F-REAL-ENV-2): /etc/environment AFTER .env — injection by the replica (Ansible) wins over the file.
EnvironmentFile=-/opt/vega-concierge/.env
EnvironmentFile=-/etc/environment
Environment=NON_INTERACTIVE=1
ExecStart=/opt/vega-concierge/scripts/boot-workshop.sh
# oneshot: GHCR pull + health-wait up to 120s exceed the 90s default.
TimeoutStartSec=900
# Retry on transient failure (network, pull).
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
