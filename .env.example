# Template de .env para PRODUÇÃO / WORKSHOP — `./scripts/up.sh` (pull GHCR, containers).
# Copie: cp .env.example .env  ·  Ajuste DEPLOYMENT_ENVIRONMENT e CONTROL_PASSWORD por VM.
#
# NÃO use o wizard em produção (validate-prod-env.sh exige .env baked). Contrato AMI: docs/reference/workshop-env-contract.md.
#
# Dev local (hot reload, sem pull): `./scripts/setup-wizard.sh` — grava OLLAMA @127.0.0.1, RAG @localhost:5434.
# Docker local com build: `./scripts/up.sh --build` — wizard modo compose (mesmas URLs de container abaixo).
#
# Convenção de comentário (auditoria):
#   `# VAR — o quê. Usado: arquivo/função. Ex.: valor típico`
#   `[dev]` = valor alternativo só p/ dev.sh / rag-init no host.

# --- Identidade do deploy -------------------------------------------------------------------------
# DEPLOYMENT_ENVIRONMENT — rótulo único desta instância (não é segredo).
# Usado: hub.py; api.py /api/health; control/app; compose pass-through.
# Por clone EC2: user-<hostname> · AMI golden pode usar user-01 como placeholder.
DEPLOYMENT_ENVIRONMENT=user-01

# --- Rede / portas (F-047, ADR-025) — informativo -------------------------------------------------
# Portas fixas sem Traefik: loja :3000 · API :8000 · Ops Console :9000 · guia Hugo :1313 · ttyd :7681 (localhost).

# --- Imagens Docker (compose.plain.yml — obrigatório p/ ./scripts/up.sh pull-only) -----------------
# IMAGE_OWNER — namespace GHCR (minúsculas). Usado: compose.plain.yml; preflight-prod.sh; verify-ghcr-public.sh.
IMAGE_OWNER=fhdumont
# IMAGE_TAG — tag publicada pelo CI (CalVer ou latest).
IMAGE_TAG=latest
# BACKEND_IMAGE — default vega-backend; use vega-backend-browser p/ simulador modo Browser (Playwright).
# BACKEND_IMAGE=vega-backend-browser

# --- LLM — Ollama Local no boot (F-REAL-ENV-1) ----------------------------------------------------
# Ollama roda no HOST; containers alcançam via host.docker.internal (extra_hosts no compose.plain.yml).
# Linux VM/EC2: o daemon Ollama precisa escutar 0.0.0.0:11434 (override systemd) — default 127.0.0.1 não alcança containers.
# LLM_PROVIDER_PROMPT_CACHE — cache_control ephemeral Anthropic (0 = off).
LLM_PROVIDER_PROMPT_CACHE=0
# LLM_CACHE_ENABLED — 0 recomendado no lab/workshop Galileo+Ollama; 1 = cache F-022 prod-like.
LLM_CACHE_ENABLED=0

# OLLAMA_BASE_URL — vista pelo backend e rag-init DENTRO do container.
# [dev] http://127.0.0.1:11434 (dev.sh / Python no host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2

# --- Splunk Agent Observability (F-GALILEO-1/2/3, opt-in) -----------------------------------------
# GALILEO_API_KEY vazia = app base, zero rede Galileo.
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
GALILEO_PROJECT=vega-concierge-dev
GALILEO_LOG_STREAM=default
# AGENT_CONTROL_URL=
# AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key

# --- Sessão de comprador Galileo (F-GALILEO-8) ----------------------------------------------------
VEGA_SESSION_IDLE_MINUTES=5

# --- RAG — catálogo semântico (F-RAG-LIVE, ADR-031) -----------------------------------------------
# Postgres pgvector sobe via profile `rag` (sem porta publicada no host em compose.plain.yml).
# RAG_ENABLED=0 ou ./scripts/up.sh --no-rag = keyword-only, sem Ollama embeddings no boot.
RAG_ENABLED=1
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_DB_USER=vega
RAG_DB_PASSWORD=vega
RAG_DB_NAME=vega_rag
# RAG_DB_PORT — só dev: porta publicada 127.0.0.1:PORT→5432 em docker-compose.yml / rag-init no host.
# [dev] 5434
# RAG_DATABASE_URL — hostname `postgres` = serviço Docker na rede compose (NÃO localhost).
# compose.plain.yml repassa isto ao backend; rag-init (docker) usa @postgres:5432 também.
# [dev] postgresql+psycopg://vega:vega@127.0.0.1:5434/vega_rag
RAG_DATABASE_URL=postgresql+psycopg://vega:vega@postgres:5432/vega_rag
RAG_TOP_K=3
REFUND_WINDOW_DAYS=30
OPENAI_API_KEY=

# --- Vega Ops Console (control/, :9000) -----------------------------------------------------------
# CONTROL_PASSWORD — senha do terminal web (ttyd). Obrigatório por clone EC2 (vault); vazio só em lab local.
CONTROL_PASSWORD=
CONTROL_TTYD_PORT=7681

# --- URLs da API (front ↔ backend, ADR-024/025) ---------------------------------------------------
# PUBLIC_API_BASE vazio = browser resolve API como http://<host-do-request>:8000 (qualquer IP de VM).
PUBLIC_API_BASE=
# API_INTERNAL_URL — SSR Next.js → backend na rede Docker.
API_INTERNAL_URL=http://backend:8000

# --- Login owner (Admin hub, DT-012) --------------------------------------------------------------
# OWNER_PASSWORD vazio = default demo owner1234 no boot — trocar em deploy real.
# OWNER_PASSWORD=

# --- Enrollment de rede (F-027) -------------------------------------------------------------------
ENROLL_TOKEN=

# --- Tiers da loja (F-STORE-EN, USD) --------------------------------------------------------------
TIER_GOLD_USD=1000
TIER_PLATINUM_USD=5000

# --- Splunk o11y (OPCIONAL — ./scripts/up.sh --o11y, ADR-030) -------------------------------------
# SPLUNK_O11Y_REALM=us1
# SPLUNK_O11Y_TOKEN=
# SPLUNK_HEC_TOKEN=
# SPLUNK_HEC_URL=

# ==================================================================================================
# BACKEND — o resto da config da app. A fonte da verdade é `backend/app/settings.py` (classe
# Settings): cada campo lá é uma variável aqui, com o MESMO default. Precedência em runtime:
# variável do ambiente do SO > este arquivo > default do campo — nas EC2s o Ansible injeta os
# tokens no ambiente, e é por isso que o ambiente vence o arquivo.
# Tudo abaixo está comentado porque o default já é o valor bom; descomente só p/ divergir.
# ==================================================================================================

# --- Identidade da build (aparecem em GET /api/health) --------------------------------------------
# VEGA_VERSION=dev
# VEGA_GIT_SHA=local
# VEGA_BUILD_DATE=

# --- Persistência ---------------------------------------------------------------------------------
# ORDERS_DB — arquivo SQLite único (pedidos, usuários, providers, flags…). Em compose: /data/vega.db.
# ORDERS_DB=
# VEGA_PERSIST_DIR — onde o fresh-state guarda o backup da cascata de LLM. Vazio = ao lado do banco.
# VEGA_PERSIST_DIR=

# --- Ciclo de vida do pedido (segundos desde o PAID) ----------------------------------------------
# ORDER_SHIP_AFTER_S=30
# ORDER_DELIVER_AFTER_S=90

# --- Auth / owner ---------------------------------------------------------------------------------
# AUTH_PBKDF2_ITERATIONS=120000
# OWNER_EMAIL=fernando@fernando.com.br
# OWNER_NAME=Fernando (Owner)
# ATENÇÃO: OWNER_PASSWORD **vazio** resolve para senha vazia. Para manter o default de demo
# (owner1234), deixe a variável AUSENTE — não a declare vazia.

# --- Regras de negócio ----------------------------------------------------------------------------
# ADMIN_INSIGHTS_WINDOW_DAYS=7
# ADMIN_RESTOCK_AT=3

# --- Gateway de pagamento simulado ----------------------------------------------------------------
# PAYMENT_LATENCY_MS=400
# PAYMENT_FAIL_RATE=0.0
# PAYMENT_LATENCY_SPIKE_MS=1500

# --- LLM: timeout, stub, cache de resposta (F-022) e inspector ------------------------------------
# LLM_TIMEOUT_S=20
# LLM_STUB_MODEL=gpt-4o-mini
# LLM_CACHE_TTL_S=300
# LLM_CACHE_MAX=256
# LLM_RATE_MAX=30
# LLM_RATE_WINDOW_S=60
# LLM_ACTIVITY_MAX=200

# --- Simulador em modo browser (F-039) ------------------------------------------------------------
# SIM_BROWSER_BASE_URL=http://localhost:3000

# --- Tokens de provider (bootstrap da cascata pelo ambiente — F-BACKEND-3) ------------------------
# Declarados desde já; a F-BACKEND-3 é que passa a criar providers a partir deles.
# ANTHROPIC_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_DEFAULT_REGION=us-east-1

# --- Carregamento deste arquivo -------------------------------------------------------------------
# VEGA_ENV_FILE — aponta a app para outro arquivo de env. Vazio ("") desliga a leitura de arquivo
# e deixa só ambiente do SO + defaults (é assim que a suíte de testes roda).
# VEGA_ENV_FILE=
