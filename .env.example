# .env template for PRODUCTION / WORKSHOP — `./scripts/up.sh` (pull GHCR, containers).
# Copy: cp .env.example .env  ·  Adjust DEPLOYMENT_ENVIRONMENT and CONTROL_PASSWORD per VM.
#
# Do NOT use the wizard in production (validate-prod-env.sh requires a baked .env). AMI contract: docs/reference/workshop-env-contract.md.
#
# Local dev (hot reload, no pull): `./scripts/setup-wizard.sh` — writes OLLAMA @127.0.0.1, RAG @localhost:5434.
# Local Docker with build: `./scripts/up.sh --build` — wizard compose mode (same container URLs below).
#
# Comment convention (audit):
#   `# VAR — what it is. Used: file/function. Ex.: typical value`
#   `[dev]` = alternate value only for dev.sh / rag-init on the host.

# --- Deploy identity -------------------------------------------------------------------------------
# DEPLOYMENT_ENVIRONMENT — unique label for this instance (not a secret).
# Used: hub.py; api.py /api/health; control/app; compose pass-through.
# EC2 clone: the replica injects INSTANCE into the OS; INSTANCE, when present, ALWAYS wins over
# this file (env-load.sh + panel :9000). user-01 = AMI placeholder (only applies without INSTANCE, e.g. local dev).
DEPLOYMENT_ENVIRONMENT=user-01

# --- Network / ports (F-047, ADR-025) — informational ----------------------------------------------
# Fixed ports, no Traefik: store :3000 · API :8000 · Ops Console :9000 · Hugo guide :1313 · ttyd :7681 (localhost).

# --- Docker images (compose.plain.yml — required for ./scripts/up.sh pull-only) --------------------
# IMAGE_OWNER — GHCR namespace (lowercase). Used: compose.plain.yml; preflight-prod.sh; verify-ghcr-public.sh.
IMAGE_OWNER=fhdumont
# IMAGE_TAG — tag published by CI (CalVer or latest).
IMAGE_TAG=latest
# BACKEND_IMAGE — default vega-backend; use vega-backend-browser for the Browser-mode simulator (Playwright).
# BACKEND_IMAGE=vega-backend-browser

# --- LLM — Local Ollama on boot (F-REAL-ENV-1) ------------------------------------------------------
# Ollama runs on the HOST; containers reach it via host.docker.internal (extra_hosts in compose.plain.yml).
# Linux VM/EC2: the Ollama daemon needs to listen on 0.0.0.0:11434 (systemd override) — the 127.0.0.1 default doesn't reach containers.
# LLM_PROVIDER_PROMPT_CACHE — Anthropic ephemeral cache_control (0 = off).
LLM_PROVIDER_PROMPT_CACHE=0
# LLM_CACHE_ENABLED — 0 recommended in the lab/workshop with Galileo+Ollama; 1 = F-022 prod-like cache.
LLM_CACHE_ENABLED=0

# OLLAMA_BASE_URL — seen by the backend and rag-init INSIDE the container.
# [dev] http://127.0.0.1:11434 (dev.sh / Python on the host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_CHAT_MODEL — local chat on boot (weak tool-calling on CPU; prefer cloud in the cascade).
# Alternatives: llama3.2:3b · qwen2.5:7b · mistral
OLLAMA_CHAT_MODEL=llama3.2
# LLM_PROVIDER_PRIORITY — cascade order on every restart; skips an alias without a credential until OLLAMA.
# Aliases: BEDROCK, OPENAI, ANTHROPIC (or CLAUDE), OLLAMA.
LLM_PROVIDER_PRIORITY=BEDROCK,OPENAI,ANTHROPIC,OLLAMA
# Default models on auto-registration (creation only; editing in Admin takes precedence afterward).
# OPENAI_CHAT_MODEL — Alternatives: gpt-4o · gpt-4.1-mini · gpt-4.1
OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_CHAT_MODEL — Alternatives: claude-haiku-4-5 · claude-opus-4-5
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
# BEDROCK_CHAT_MODEL — Bedrock ID (cross-region `us.` recommended). Ex.: anthropic.claude-sonnet-4-5-20250929-v1:0 · us.amazon.nova-pro-v1:0
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Cloud tokens — present = auto-registers the provider in the cascade on boot (ADR-039).
# Env wins over key/order/enabled on every restart; UI wins over model/base_url edited in Admin.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-east-1

# --- Splunk Agent Observability (F-GALILEO-1/2/3, opt-in) -------------------------------------------
# GALILEO_API_KEY empty = base app, zero Galileo network traffic.
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
GALILEO_PROJECT=vega-concierge-dev
GALILEO_LOG_STREAM=default
# AGENT_CONTROL_URL=
# AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key

# --- Galileo shopper session (F-GALILEO-8) -----------------------------------------------------------
VEGA_SESSION_IDLE_MINUTES=5

# --- RAG — semantic catalog (F-RAG-LIVE, ADR-031) ----------------------------------------------------
# Postgres pgvector comes up via the `rag` profile (no port published on the host in compose.plain.yml).
# RAG_ENABLED — 0 (or `./scripts/up.sh --no-rag`) = keyword-only, no Ollama embeddings on boot.
RAG_ENABLED=1
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_DB_USER=vega
RAG_DB_PASSWORD=vega
RAG_DB_NAME=vega_rag
# RAG_DB_PORT — dev only: port published at 127.0.0.1:PORT→5432 in docker-compose.yml / rag-init on the host.
# [dev] 5434
# RAG_DB_PORT=5434
# RAG_DATABASE_URL — hostname `postgres` = Docker service on the compose network (NOT localhost).
# compose.plain.yml passes this to the backend; rag-init (docker) also uses @postgres:5432.
# [dev] postgresql+psycopg://vega:vega@127.0.0.1:5434/vega_rag
RAG_DATABASE_URL=postgresql+psycopg://vega:vega@postgres:5432/vega_rag
RAG_TOP_K=3
REFUND_WINDOW_DAYS=30

# --- Vega Ops Console (control/, :9000) --------------------------------------------------------------
# CONTROL_PASSWORD — web terminal (ttyd) password. Required per EC2 clone (vault); empty only in a local lab.
CONTROL_PASSWORD=
CONTROL_TTYD_PORT=7681

# --- API URLs (front ↔ backend, ADR-024/025) ----------------------------------------------------------
# PUBLIC_API_BASE empty = the browser resolves the API as http://<request-host>:8000 (any VM IP).
PUBLIC_API_BASE=
# API_INTERNAL_URL — Next.js SSR → backend on the Docker network.
API_INTERNAL_URL=http://backend:8000

# --- Owner login (Admin hub, DT-012) --------------------------------------------------------------------
# OWNER_PASSWORD empty = demo default owner1234 on boot — change it for a real deploy.
# OWNER_PASSWORD=

# --- Network enrollment (F-027, ADR-020) ------------------------------------------------------------------
# ENROLL_TOKEN — SHARED secret for the lab (same value across ALL workshop VMs).
# Used: backend/app/hub/enroll.py — gate for POST /api/admin/enroll (enroll-push by IP).
# Whoever holds this token can point a store at a hub via API (machine-to-machine); it is NOT the
# hub's serve_token (that one lives in Admin → Connection / Hub and authenticates the GET /api/hub/config pull).
# Empty = enroll disabled (401) — standalone-first: a store outside the lab isn't reconfigurable over the network.
# Workshop: inject via Ansible/vault into every clone; the hub owner pastes the same value into the
# "Push enrollment → Enroll secret" form. Never reaches the browser — only backend + owner form on the hub VM.
ENROLL_TOKEN=

# --- Store tiers (F-STORE-EN, USD) ---------------------------------------------------------------------
TIER_GOLD_USD=1000
TIER_PLATINUM_USD=5000

# ======================================================================================================
# BACKEND — the rest of the app's config. The source of truth is `backend/app/settings.py` (the
# Settings class): each field there is a variable here, with the SAME default. Precedence at runtime:
# OS environment variable > this file > field default — in EVERY layer (shell scripts,
# systemd units, and the container via .env.runtime; F-REAL-ENV-2). On EC2s the replica (Ansible)
# injects per-clone values into the OS environment (/etc/environment), which is why the environment wins.
# Everything below is commented out because the default is already the right value; uncomment only to diverge.
# ======================================================================================================

# --- Build identity (shown in GET /api/health) -----------------------------------------------------------
# VEGA_VERSION=dev
# VEGA_GIT_SHA=local
# VEGA_BUILD_DATE=

# --- Persistence -------------------------------------------------------------------------------------------
# ORDERS_DB — single SQLite file (orders, users, providers, flags…). In compose: /data/vega.db.
# ORDERS_DB=
# VEGA_PERSIST_DIR — where fresh-state keeps the LLM cascade backup. Empty = next to the database.
# VEGA_PERSIST_DIR=

# --- Order lifecycle (seconds since PAID) -------------------------------------------------------------------
# ORDER_SHIP_AFTER_S=30
# ORDER_DELIVER_AFTER_S=90

# --- Auth / owner ----------------------------------------------------------------------------------------------
# AUTH_PBKDF2_ITERATIONS=120000
# OWNER_EMAIL=fernando@fernando.com.br
# OWNER_NAME=Fernando (Owner)
# WARNING: OWNER_PASSWORD **empty** resolves to an empty password. To keep the demo default
# (owner1234), leave the variable ABSENT — don't declare it empty.

# --- Business rules --------------------------------------------------------------------------------------------
# ADMIN_INSIGHTS_WINDOW_DAYS=7
# ADMIN_RESTOCK_AT=3

# --- Simulated payment gateway --------------------------------------------------------------------------------
# PAYMENT_LATENCY_MS=400
# PAYMENT_FAIL_RATE=0.0
# PAYMENT_LATENCY_SPIKE_MS=1500

# --- LLM: timeout, stub, response cache (F-022), and inspector -----------------------------------------------
# LLM_TIMEOUT_S=20
# LLM_STUB_MODEL=gpt-4o-mini
# LLM_CACHE_TTL_S=300
# LLM_CACHE_MAX=256
# LLM_RATE_MAX=20
# LLM_RATE_WINDOW_S=60
# LLM_ACTIVITY_MAX=200

# --- Edge HTTP rate limit (F-WORKSHOP-GUARD) --------------------------------------------------------------------
# API_RATE_ENABLED=1
# API_RATE_AI_MAX=12
# API_RATE_AI_WINDOW_S=60
# API_RATE_DEFAULT_MAX=60
# API_RATE_DEFAULT_WINDOW_S=60

# --- Browser-mode simulator (F-039) ----------------------------------------------------------------------------
# SIM_BROWSER_BASE_URL=http://localhost:3000

# --- Loading this file ---------------------------------------------------------------------------------------------
# VEGA_ENV_FILE — points the app at a different env file. Empty ("") turns off file reading
# and leaves only the OS environment + defaults (this is how the test suite runs).
# VEGA_ENV_FILE=
