# Copy to .env and adjust. In the lab, Ansible injects these values per VM.
# Or run: ./scripts/setup-wizard.sh
#
# Convenção de comentário (auditoria):
#   `# VAR — o quê. Usado: arquivo/função. Ex.: valor típico`
#   Blocos agrupam vars relacionadas; vars com `# VAR=` (comentadas) = opt-in ou só infra/scripts.
#   "NÃO usado" = não há os.getenv/leitura no repo; pode ser reserva ou só documentação.

# --- Identidade do deploy -------------------------------------------------------------------------
# DEPLOYMENT_ENVIRONMENT — rótulo único desta instância (não é segredo).
# Usado: hub.py + runnable_config.py (identidade hub/cliente, header X-Hub-Env anti-loop);
#        api.py GET /api/health; control/app/main.py GET /api/state;
#        dev.sh/up.sh (--o11y → OTEL deployment.environment); compose*.yml (pass-through p/ backend).
# Ex.: user-01 (lab 20 VMs) · FDUMONT-M-7QJL (laptop) · prod-us-east
DEPLOYMENT_ENVIRONMENT=user-01

# --- Rede / portas (F-047, ADR-025) — informativo; sem vars de ambiente ---------------------------
# Portas fixas sem Traefik: loja :3000 · API :8000 · Ops Console :9000 · terminal :7681.
# Usado: compose.plain.yml/docker-compose.yml (mapeamento ports), README/runbooks.
# Ex.: http://203.0.113.10:3000 (loja) · :8000 (API) · :9000 (control)

# --- Imagens Docker (compose.plain.yml / produção pull-only) --------------------------------------
# Só em `./scripts/up.sh` sem --build (pull GHCR). Dev local com --build ignora na prática.
# IMAGE_OWNER — namespace GHCR das imagens vega-*.
# Usado: compose.plain.yml (image: ghcr.io/${IMAGE_OWNER}/…); up.sh; preflight-prod.sh.
# Ex.: fhdumont
# IMAGE_TAG — tag da imagem publicada.
# Usado: idem (default latest).
# Ex.: latest · v1.2.0 · sha-abc1234
# IMAGE_OWNER=fhdumont
# IMAGE_TAG=latest

# --- Simulador browser (F-039, opt-in) ----------------------------------------------------------
# BACKEND_IMAGE — nome da imagem backend no GHCR (variante com Playwright/Chromium).
# Usado: compose.plain.yml; up.sh/preflight-prod.sh (montam ghcr.io/owner/${BACKEND_IMAGE}:tag).
# Ex.: vega-backend-browser (RUM real) · default implícito vega-backend (modo API only)
# BACKEND_IMAGE=vega-backend-browser

# --- LLM — Ollama Local no boot (F-REAL-ENV-1) ----------------------------------------------------
# Boot: restore backup → seed_ollama_default() cria "Ollama Local" se SQLite vazio.
# Outros providers (OpenAI, Anthropic, Bedrock): Admin → Config (SQLite) — não .env.
#
# LLM_PROVIDER_PROMPT_CACHE — 1 = cache_control ephemeral no system (só family anthropic na cascata).
# Usado: llm_models.py (F-COST-CACHE; providers cadastrados na UI com kind=anthropic).
# Ex.: 0 (default off) · 1 (workshop Anthropic)
LLM_PROVIDER_PROMPT_CACHE=0

# LLM_CACHE_ENABLED — 1 = cache F-022 como hoje (hit/miss/single-flight); 0 = sempre miss, nunca grava, sem span check_response_cache (metadata response_cache=disabled — lab Galileo).
# Recomendado 0 no lab Galileo/Ollama (evita retriever ausente em hit e respostas stale cross-SKU).
# Usado: llm_cache.py cache_globally_enabled().
# Ex.: 1 (default prod-like) · 0 (workshop/lab)
LLM_CACHE_ENABLED=1

# --- Ollama no host (F-REAL-ENV-1) ----------------------------------------------------------------
# Ollama roda no HOST; container alcança via host.docker.internal (extra_hosts no compose).
#
# OLLAMA_BASE_URL — URL do daemon Ollama vista pelo backend (chat seed + embeddings RAG).
# Usado: llm_config.py seed_ollama_default(); rag.py OllamaEmbeddings; api.py /api/health (ollama.reachable);
#        rag-init.sh; preflight-prod.sh (probe modelos).
# Ex.: http://host.docker.internal:11434 (Docker) · http://127.0.0.1:11434 (dev.sh no host)
# OLLAMA_CHAT_MODEL — modelo do provider "Ollama Local" seedado no boot.
# Usado: llm_config.py seed_ollama_default(); api.py health; preflight-prod.sh.
# Ex.: llama3.2 · llama3.2:3b (EC2 pouca RAM)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2

# --- Splunk Agent Observability — observabilidade principal (F-GALILEO-1/2/3, ADR-032/033) -------------------------
# GALILEO_API_KEY vazia = zero rede Splunk Agent Observability (demo "base"). Preenchida = traces + evaluators + Control.
# Ortogonal ao Splunk (--o11y). Usado: galileo_obs.py (is_enabled, callbacks, session); galileo_control.py.
#
# GALILEO_API_KEY — autentica SDK Splunk Agent Observability + Agent Control.
# Usado: galileo_obs.py; galileo_control.py init client.
# Ex.: sgR-... (Console → Settings → API Keys)
# GALILEO_CONSOLE_URL — URL do tenant (links UI + derivar agent-control).
# Usado: galileo_obs.py console_url(); galileo_control.py (fallback AGENT_CONTROL_URL).
# Ex.: https://console.multitenant.galileocloud.io
# GALILEO_PROJECT — projeto onde traces/sessions são gravados.
# Usado: galileo_obs.py project() → galileo_context(project=…).
# Ex.: vega-concierge-dev
# GALILEO_LOG_STREAM — log stream dentro do projeto (aceita alias GALILEO_LOGSTREAM).
# Usado: galileo_obs.py log_stream() → galileo_context(log_stream=…).
# Ex.: default · workshop-day1
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
GALILEO_PROJECT=vega-concierge-dev
GALILEO_LOG_STREAM=default

# --- Splunk Agent Observability Agent Control / Protect (F-GALILEO-2, opt-in) ----------------------------------------
# Rulesets ficam no Console; estas vars só apontam o endpoint HTTP.
#
# AGENT_CONTROL_URL — override da URL Protect/Control (default: GALILEO_CONSOLE_URL com console→agent-control).
# Usado: galileo_control.py; galileo_obs.py agent_control_url() → GET /api/galileo/config.
# AGENT_CONTROL_API_KEY_HEADER — header HTTP da API key no Control.
# Usado: galileo_control.py (default Galileo-API-Key).
# AGENT_CONTROL_URL=
# AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key

# --- Sessão de comprador Splunk Agent Observability (F-GALILEO-8) ----------------------------------------------------
# VEGA_SESSION_IDLE_MINUTES — minutos sem request de IA antes do front rotacionar UUID (localStorage).
# Usado: galileo_obs.py session_idle_minutes() → GET /api/galileo/config → frontend configureShopperSession.
# Ex.: 5 (demo) · 0 (só manual via botão "New session" no BTS)
VEGA_SESSION_IDLE_MINUTES=5

# --- RAG — catálogo semântico (F-RAG-LIVE, ADR-031) -----------------------------------------------
# RAG_ENABLED=1: Postgres+pgvector + embeddings. dev.sh/up.sh sobem Postgres (profile rag) e indexam
# (scripts/lib/rag-init.sh → setup_vectordb.py). RAG_ENABLED=0 ou --no-rag = keyword-only (rag.py fallback).
#
# RAG_ENABLED — liga caminho pgvector (requer RAG_DATABASE_URL).
# Usado: rag.py pgvector_enabled(); dev.sh/up.sh/rag-init.sh (gate subir Postgres).
# Ex.: 1 · 0
# RAG_EMBEDDING_PROVIDER — ollama (default) ou openai.
# Usado: rag.py embedding_provider()/embeddings(); rag-init.sh (valida OPENAI_API_KEY se openai).
# RAG_EMBEDDING_MODEL — modelo de embedding.
# Usado: rag.py embeddings(); api.py /api/health; rag-init.sh; preflight-prod.sh.
# Ex.: nomic-embed-text (Ollama) · text-embedding-3-small (OpenAI)
# RAG_DB_USER — usuário Postgres do serviço rag (profile docker).
# Usado: docker-compose.yml/compose.plain.yml (POSTGRES_USER + monta RAG_DATABASE_URL interna); rag-init.sh.
# RAG_DB_PASSWORD — senha Postgres RAG. Usado: idem RAG_DB_USER.
# RAG_DB_NAME — database Postgres RAG. Usado: idem.
# RAG_DB_PORT — porta publicada no host (127.0.0.1:PORT→5432) p/ scripts no laptop.
# Usado: docker-compose.yml ports; rag-init.sh (host path).
# Ex.: 5434 (5432 costuma ocupada localmente)
# RAG_DATABASE_URL — DSN lido pelo backend e setup_vectordb no HOST.
# Usado: rag.py database_url()/pgvector_enabled(); setup_vectordb.py; rag-init.sh (modo host).
# Nota: backend no Docker recebe URL interna @postgres:5432 via compose — não confundir.
# Ex.: postgresql+psycopg://vega:vega@localhost:5434/vega_rag
# RAG_TOP_K — chunks retornados por busca semântica/policies.
# Usado: rag.py DEFAULT_K (retrievers VegaKeyword + PGVector).
# Ex.: 3
# REFUND_WINDOW_DAYS — janela de devolução simulada (dias); injeta {{REFUND_WINDOW_DAYS}} em policies.
# Usado: tools.py policy_lookup; agents.py/graphs/returns.py elegibilidade; galileo_control.py contexto;
#        rag.py indexação policies/returns.md; compose pass-through.
# Ex.: 30
# OPENAI_API_KEY — embeddings OpenAI (RAG_EMBEDDING_PROVIDER=openai) e juiz Deepeval (--o11y).
# Usado: langchain OpenAIEmbeddings (env padrão OpenAI); rag-init.sh; dev.sh/compose.o11y.yml (Deepeval).
# Ex.: vazio com ollama (default workshop)
RAG_ENABLED=1
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_DB_USER=vega
RAG_DB_PASSWORD=vega
RAG_DB_NAME=vega_rag
RAG_DB_PORT=5434
RAG_DATABASE_URL=postgresql+psycopg://vega:vega@localhost:5434/vega_rag
RAG_TOP_K=3
REFUND_WINDOW_DAYS=30
OPENAI_API_KEY=

# --- Vega Ops Console (control/, :9000) -----------------------------------------------------------
# Painel manutenção + terminal web. Painel aberto; senha só no terminal (/shell).
#
# CONTROL_PASSWORD — auth Basic do terminal web (ttyd) via control/app/main.py.
# Usado: control/app/main.py _terminal_password(); scripts/control.sh; ansible playbook.
# Ex.: string forte em deploy real · vazio = wizard pede
# CONTROL_TTYD_PORT — porta do ttyd (iframe terminal no painel).
# Usado: control/app/main.py; scripts/control.sh; systemd vega-ttyd.service.
# Ex.: 7681
CONTROL_PASSWORD=
CONTROL_TTYD_PORT=7681

# --- URLs da API (front ↔ backend, ADR-024/025) ---------------------------------------------------
# Browser chama API direto (window.__API_BASE); SSR Next usa URL interna.
#
# PUBLIC_API_BASE — URL pública da API injetada em runtime no browser (layout.tsx → window.__API_BASE).
# Usado: frontend/app/layout.tsx resolvePublicApiBase(); lib/api.ts (fetch browser-side).
# Vazio = auto: http://<host-do-request>:8000 (1 imagem serve qualquer IP de VM).
# Ex.: vazio (compose prod) · http://localhost:8000 (dev host) · http://203.0.113.10:8000
# API_INTERNAL_URL — URL do backend p/ SSR e server components.
# Usado: frontend/lib/api.ts (BASE no server); layout.tsx (RUM server-side fetch).
# Ex.: http://localhost:8000 (dev host) · http://backend:8000 (Docker compose)
# PUBLIC_API_BASE=
# API_INTERNAL_URL=http://backend:8000

# --- Login owner (Admin hub, DT-012) --------------------------------------------------------------
# OWNER_PASSWORD — senha do usuário owner seedado no boot (fernando@fernando.com.br).
# Usado: users.py ensure_owner() (PBKDF2); compose.plain.yml/ansible pass-through.
# Default código owner1234 se vazio — trocar em deploy real.
# OWNER_PASSWORD=

# --- Enrollment de rede (F-027, ADR-020) ----------------------------------------------------------
# ENROLL_TOKEN — segredo compartilhado do lab p/ POST /api/admin/enroll (push hub→lojas por IP).
# Usado: enroll.py enroll_secret()/verify_enroll_token(); UI Admin Connection (enroll secret).
# Vazio = standalone (401 em enroll remoto).
# Ex.: token gerado pelo setup-wizard num lab multi-VM
ENROLL_TOKEN=

# --- Tiers da loja (F-STORE-EN) -------------------------------------------------------------------
# Limites de gasto acumulado (USD) p/ tier Gold/Platinum no backend.
# TIER_GOLD_USD — threshold Gold.
# Usado: users.py tier_for_spend() (autoritativo p/ tier do usuário).
# Ex.: 1000
# TIER_PLATINUM_USD — threshold Platinum. Usado: idem.
# Ex.: 5000
# Nota: frontend/lib/shop.ts espelha 1000/5000 hardcoded só p/ UI de progresso — mudar .env exige alinhar shop.ts.
TIER_GOLD_USD=1000
TIER_PLATINUM_USD=5000

# --- Splunk o11y (OPCIONAL — ./scripts/dev.sh --o11y · ./scripts/up.sh --o11y, ADR-030) ----------
# App sem --o11y = cega. Com --o11y: OTEL_* têm default nos scripts; aqui só segredos do Collector.
#
# SPLUNK_O11Y_REALM — realm Splunk Observability (ingest URLs).
# Usado: otel-collector-config.yaml (ingest.${SPLUNK_O11Y_REALM}.signalfx.com); compose.o11y.yml; dev.sh log.
# Ex.: us1 · eu0
# SPLUNK_O11Y_TOKEN — token ingest traces+métricas APM (header X-SF-Token).
# Usado: otel-collector-config.yaml splunk_o11y exporter.
# SPLUNK_HEC_TOKEN — token HEC p/ logs.
# Usado: otel-collector-config.yaml splunk_hec exporter.
# SPLUNK_HEC_URL — endpoint HEC Splunk Platform/Cloud.
# Usado: otel-collector-config.yaml splunk_hec endpoint.
# Ex.: https://http-inputs-<stack>.splunkcloud.com:443/services/collector
# SPLUNK_O11Y_REALM=us1
# SPLUNK_O11Y_TOKEN=
# SPLUNK_HEC_TOKEN=
# SPLUNK_HEC_URL=
